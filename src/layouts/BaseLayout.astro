---
import '@/styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS } from '@/consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="William Peytz" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur">
      <div class="container-wide flex h-14 items-center justify-between gap-6">
        <a href="/" class="font-semibold tracking-tightest no-underline">
          <span class="text-gradient">Peytz</span><span class="text-fg">Games</span>
        </a>
        <nav class="flex items-center gap-4 text-sm">
          <a
            href="/#games"
            class="text-fg-muted hover:text-fg transition-colors no-underline"
          >
            Games
          </a>
          <a
            href={LINKS.personalSite}
            class="text-fg-muted hover:text-fg transition-colors no-underline"
          >
            williampeytz.com
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border py-8">
      <div
        class="container-wide flex flex-wrap items-center justify-between gap-4 text-sm text-fg-subtle"
      >
        <p>© {new Date().getFullYear()} William Peytz</p>
        <div class="flex gap-4">
          <a
            href={LINKS.email}
            class="hover:text-fg transition-colors no-underline">Email</a
          >
          <a
            href={LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-fg transition-colors no-underline">GitHub</a
          >
          <a
            href={LINKS.personalSite}
            class="hover:text-fg transition-colors no-underline"
            >williampeytz.com</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
