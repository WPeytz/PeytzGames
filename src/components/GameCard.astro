---
import { ArrowUpRight, Play } from '@lucide/astro';
import type { Game } from '@/data/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const playable = game.status !== 'coming soon';
const href = game.embed ? `/play/${game.slug}` : game.url;
const external = !game.embed;

const statusStyles = {
  live: 'bg-accent/15 text-accent border-accent/30',
  beta: 'bg-accent-alt/15 text-accent-alt border-accent-alt/30',
  'coming soon': 'bg-bg text-fg-subtle border-border-strong',
}[game.status];
---

<a
  href={playable ? href : undefined}
  target={playable && external ? '_blank' : undefined}
  rel={playable && external ? 'noopener noreferrer' : undefined}
  class:list={[
    'group block overflow-hidden rounded-xl border border-border bg-bg-elevated transition-colors no-underline',
    playable ? 'hover:border-accent/60' : 'opacity-70 cursor-default',
  ]}
>
  <div class="aspect-video w-full overflow-hidden bg-bg">
    {
      game.thumbnail ? (
        <img
          src={game.thumbnail}
          alt={`${game.title} thumbnail`}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent/10 via-bg to-accent-alt/10">
          <span class="text-2xl font-semibold tracking-tightest text-fg-muted group-hover:text-gradient transition-colors">
            {game.title}
          </span>
        </div>
      )
    }
  </div>
  <div class="flex items-start justify-between gap-4 p-5">
    <div class="flex flex-col gap-1.5 min-w-0">
      <div class="flex items-center gap-2">
        <h3 class="font-medium text-fg group-hover:text-accent transition-colors">
          {game.title}
        </h3>
        <span
          class:list={[
            'rounded-full border px-2 py-0.5 text-[11px] leading-4',
            statusStyles,
          ]}
        >
          {game.status}
        </span>
      </div>
      <p class="text-sm text-fg-muted">{game.tagline}</p>
    </div>
    {
      playable &&
        (external ? (
          <ArrowUpRight
            class="h-4 w-4 flex-shrink-0 text-fg-subtle group-hover:text-accent transition-colors"
            aria-hidden="true"
          />
        ) : (
          <Play
            class="h-4 w-4 flex-shrink-0 text-fg-subtle group-hover:text-accent transition-colors"
            aria-hidden="true"
          />
        ))
    }
  </div>
</a>
