---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ArrowLeft, Maximize } from '@lucide/astro';
import { GAMES } from '@/data/games';

export function getStaticPaths() {
  return GAMES.filter((game) => game.embed && !game.hidden).map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const configuredGameUrl = new URL(game.url);
const isPeytzGamesHosted = ['peytzgames.com', 'www.peytzgames.com'].includes(
  configuredGameUrl.hostname,
);
const gameUrl = import.meta.env.DEV && isPeytzGamesHosted
  ? configuredGameUrl.pathname.endsWith('/')
    ? `${configuredGameUrl.pathname}index.html`
    : configuredGameUrl.pathname
  : game.url;
const gameOrigin = import.meta.env.DEV && isPeytzGamesHosted
  ? Astro.url.origin
  : configuredGameUrl.origin;
---

<BaseLayout title={game.title} description={game.tagline}>
  <section class="container-wide py-8">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <a
          href="/"
          class="mb-2 inline-flex items-center gap-1 text-sm text-fg-muted hover:text-accent transition-colors no-underline"
        >
          <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
          All games
        </a>
        <h1 class="text-4xl font-semibold tracking-tightest">{game.title}</h1>
        <p class="mt-3 text-fg-muted">
          {game.tagline}
          {game.controls && <span class="block mt-1">{game.controls}</span>}
        </p>
      </div>
      <button
        id="fullscreen-btn"
        type="button"
        class="inline-flex items-center gap-1 rounded-md border border-border bg-bg-elevated px-3 py-1.5 text-sm text-fg-muted hover:border-accent hover:text-accent transition-colors"
      >
        Fullscreen
        <Maximize class="h-4 w-4" aria-hidden="true" />
      </button>
    </header>

    <div class="overflow-hidden rounded-xl border border-border bg-bg-elevated">
      <iframe
        id="game-frame"
        src={gameUrl}
        title={game.title}
        data-sso={game.sso ? 'true' : undefined}
        class="block h-[85vh] min-h-[640px] w-full border-0"
        allow="fullscreen; autoplay"
        loading="lazy"></iframe>
    </div>

    {
      game.leaderboard && (
        <div
          id="leaderboard"
          data-game={game.slug}
          data-origin={gameOrigin}
          data-kind={game.scoreKind ?? 'points'}
          class="mt-8 max-w-md"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-tightest">
              Leaderboard
            </h2>
            <p id="lb-status" class="text-sm text-fg-subtle" />
          </div>
          <ol
            id="lb-list"
            class="mt-4 divide-y divide-border rounded-xl border border-border bg-bg-elevated"
          >
            <li class="px-4 py-3 text-sm text-fg-subtle">Loading…</li>
          </ol>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  // Games that report their content height (embed:height via postMessage)
  // get an iframe sized to fit, so there's no nested scrollbar.
  const gameFrame = document.getElementById('game-frame') as HTMLIFrameElement;
  const frameOrigin = new URL(gameFrame.src).origin;

  // Fullscreen the game in place — the page stays on /play/<slug>.
  const fullscreenBtn = document.getElementById('fullscreen-btn');
  fullscreenBtn?.addEventListener('click', () => {
    gameFrame.requestFullscreen?.();
  });

  // Some embedded games (e.g. LastNameLegacy) autofocus an input when they
  // load. Focusing an element inside a cross-origin iframe makes the browser
  // scroll the parent page down to reveal it. Pin the page back to wherever
  // the user was for a short window after the frame loads to cancel the jump.
  gameFrame.addEventListener('load', () => {
    const x = window.scrollX;
    const y = window.scrollY;
    const start = performance.now();
    let active = true;
    // If the user deliberately scrolls, stop fighting them.
    const stop = () => {
      active = false;
    };
    const opts = { passive: true } as AddEventListenerOptions;
    window.addEventListener('wheel', stop, opts);
    window.addEventListener('touchmove', stop, opts);
    window.addEventListener('keydown', stop, opts);
    const pin = () => {
      if (!active) return cleanup();
      if (window.scrollX !== x || window.scrollY !== y) window.scrollTo(x, y);
      if (performance.now() - start < 600) requestAnimationFrame(pin);
      else cleanup();
    };
    const cleanup = () => {
      window.removeEventListener('wheel', stop, opts);
      window.removeEventListener('touchmove', stop, opts);
      window.removeEventListener('keydown', stop, opts);
    };
    requestAnimationFrame(pin);
  });

  window.addEventListener('message', (event) => {
    if (event.origin !== frameOrigin) return;
    const msg = event.data;
    if (msg?.type === 'embed:height' && typeof msg.height === 'number') {
      const height = Math.min(Math.max(Math.ceil(msg.height), 480), 4000);
      gameFrame.style.height = `${height}px`;
      gameFrame.style.minHeight = '0';
    }
  });
</script>

<script>
  // Single sign-on bridge: for games that share PeytzGames' Supabase project
  // (data-sso="true"), hand the host page's session into the iframe so the
  // user never has to log in again inside the game. Tokens are sensitive, so
  // every message is locked to the game's exact origin.
  import { supabase } from '@/lib/supabase';

  const ssoFrame = document.getElementById('game-frame') as HTMLIFrameElement;

  if (ssoFrame?.dataset.sso === 'true') {
    const targetOrigin = new URL(ssoFrame.src).origin;

    function postToGame(message: unknown) {
      ssoFrame.contentWindow?.postMessage(message, targetOrigin);
    }

    // Read the session straight from storage rather than
    // supabase.auth.getSession(): in this embedding host page getSession() can
    // hang on navigator.locks while authenticated, so the game's on-demand
    // session request would silently never get answered — leaving logged-in
    // users stuck on the game's "Sign in to Play" screen.
    function readStoredSession(): { access_token?: string; refresh_token?: string } | null {
      try {
        const key = Object.keys(localStorage).find((k) =>
          /^sb-.*-auth-token$/.test(k),
        );
        if (!key) return null;
        let raw = localStorage.getItem(key);
        if (!raw) return null;
        if (raw.startsWith('base64-')) raw = atob(raw.slice(7));
        const parsed = JSON.parse(raw);
        if (parsed?.access_token) return parsed;
        if (parsed?.currentSession?.access_token) return parsed.currentSession;
        return null;
      } catch {
        return null;
      }
    }

    function sendSession() {
      const session = readStoredSession();
      if (session?.access_token && session?.refresh_token) {
        postToGame({
          type: 'peytz:session',
          access_token: session.access_token,
          refresh_token: session.refresh_token,
        });
      } else {
        postToGame({ type: 'peytz:signout' });
      }
    }

    // Push the session once the frame has loaded, and again whenever the
    // login state changes (sign in, sign out, token refresh).
    ssoFrame.addEventListener('load', sendSession);
    supabase.auth.onAuthStateChange(() => sendSession());

    // The game may finish booting after our first push; let it ask for the
    // session when it's ready.
    window.addEventListener('message', (event) => {
      if (event.origin !== targetOrigin) return;
      if (event.data?.type === 'peytz:session:request') sendSession();
    });
  }
</script>

<script>
  import { supabase } from '@/lib/supabase';

  const root = document.getElementById('leaderboard');

  if (root) {
    const gameSlug = root.dataset.game!;
    const gameOrigin = root.dataset.origin!;
    // 'time' scores are milliseconds where lower is better (speedruns);
    // default 'points' scores are higher-is-better numbers.
    const isTime = root.dataset.kind === 'time';
    const list = document.getElementById('lb-list')!;
    const status = document.getElementById('lb-status')!;

    function formatScore(score: number): string {
      if (!isTime) return score.toLocaleString();
      const minutes = Math.floor(score / 60000);
      const seconds = Math.floor((score % 60000) / 1000);
      const millis = score % 1000;
      return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
    }

    async function loadLeaderboard() {
      // Pull extra rows, then keep each player's best score.
      const { data, error } = await supabase
        .from('scores')
        .select('score, profiles(username)')
        .eq('game', gameSlug)
        .order('score', { ascending: isTime })
        .limit(50);

      if (error || !data) {
        list.innerHTML = `<li class="px-4 py-3 text-sm text-fg-subtle">Couldn't load the leaderboard.</li>`;
        return;
      }

      const best = new Map<string, number>();
      for (const row of data) {
        const name =
          (row.profiles as unknown as { username: string } | null)?.username ??
          'anonymous';
        if (!best.has(name)) best.set(name, row.score);
      }
      const top = [...best.entries()].slice(0, 10);

      list.innerHTML =
        top.length === 0
          ? `<li class="px-4 py-3 text-sm text-fg-subtle">No scores yet — be the first.</li>`
          : top
              .map(
                ([name, score], i) => `
                  <li class="flex items-center justify-between px-4 py-2.5 text-sm">
                    <span class="flex items-center gap-3">
                      <span class="w-5 text-right text-fg-subtle">${i + 1}</span>
                      <span class="text-fg">${name.replace(/[<>&]/g, '')}</span>
                    </span>
                    <span class="font-medium text-accent-alt">${formatScore(score)}</span>
                  </li>`,
              )
              .join('');
    }

    async function submitScore(score: number) {
      const { data: sessionData } = await supabase.auth.getSession();
      const session = sessionData.session;
      if (!session) {
        status.textContent = 'Log in to post your scores.';
        return;
      }
      const { error } = await supabase.from('scores').insert({
        user_id: session.user.id,
        game: gameSlug,
        score,
      });
      if (!error) {
        status.textContent = `${isTime ? 'Time' : 'Score'} saved: ${formatScore(score)}`;
        loadLeaderboard();
      }
    }

    window.addEventListener('message', (event) => {
      if (event.origin !== gameOrigin) return;
      const msg = event.data;
      if (
        msg?.type === `${gameSlug}:gameover` &&
        typeof msg.score === 'number' &&
        msg.score > 0
      ) {
        submitScore(Math.floor(msg.score));
      }
    });

    loadLeaderboard();
  }
</script>
