---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import { GAMES } from '@/data/games';

export function getStaticPaths() {
  return GAMES.filter((game) => game.embed).map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
---

<BaseLayout title={game.title} description={game.tagline}>
  <section class="container-wide py-8">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <a
          href="/"
          class="mb-2 inline-flex items-center gap-1 text-sm text-fg-muted hover:text-accent transition-colors no-underline"
        >
          <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
          All games
        </a>
        <h1 class="text-4xl font-semibold tracking-tightest">{game.title}</h1>
        <p class="mt-3 text-fg-muted">
          {game.tagline}
          {game.controls && <span class="block mt-1">{game.controls}</span>}
        </p>
      </div>
      <a
        href={game.url}
        class="inline-flex items-center gap-1 rounded-md border border-border bg-bg-elevated px-3 py-1.5 text-sm text-fg-muted hover:border-accent hover:text-accent transition-colors no-underline"
      >
        Open fullscreen
        <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </header>

    <div class="overflow-hidden rounded-xl border border-border bg-bg-elevated">
      <iframe
        id="game-frame"
        src={game.url}
        title={game.title}
        class="block h-[85vh] min-h-[640px] w-full border-0"
        allow="fullscreen; autoplay"
        loading="lazy"></iframe>
    </div>

    {
      game.leaderboard && (
        <div
          id="leaderboard"
          data-game={game.slug}
          data-origin={new URL(game.url).origin}
          class="mt-8 max-w-md"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-tightest">
              Leaderboard
            </h2>
            <p id="lb-status" class="text-sm text-fg-subtle" />
          </div>
          <ol
            id="lb-list"
            class="mt-4 divide-y divide-border rounded-xl border border-border bg-bg-elevated"
          >
            <li class="px-4 py-3 text-sm text-fg-subtle">Loading…</li>
          </ol>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  // Games that report their content height (embed:height via postMessage)
  // get an iframe sized to fit, so there's no nested scrollbar.
  const gameFrame = document.getElementById('game-frame') as HTMLIFrameElement;
  const frameOrigin = new URL(gameFrame.src).origin;

  window.addEventListener('message', (event) => {
    if (event.origin !== frameOrigin) return;
    const msg = event.data;
    if (msg?.type === 'embed:height' && typeof msg.height === 'number') {
      const height = Math.min(Math.max(Math.ceil(msg.height), 480), 4000);
      gameFrame.style.height = `${height}px`;
      gameFrame.style.minHeight = '0';
    }
  });
</script>

<script>
  import { supabase } from '@/lib/supabase';

  const root = document.getElementById('leaderboard');

  if (root) {
    const gameSlug = root.dataset.game!;
    const gameOrigin = root.dataset.origin!;
    const list = document.getElementById('lb-list')!;
    const status = document.getElementById('lb-status')!;

    async function loadLeaderboard() {
      // Pull extra rows, then keep each player's best score.
      const { data, error } = await supabase
        .from('scores')
        .select('score, profiles(username)')
        .eq('game', gameSlug)
        .order('score', { ascending: false })
        .limit(50);

      if (error || !data) {
        list.innerHTML = `<li class="px-4 py-3 text-sm text-fg-subtle">Couldn't load the leaderboard.</li>`;
        return;
      }

      const best = new Map<string, number>();
      for (const row of data) {
        const name =
          (row.profiles as unknown as { username: string } | null)?.username ??
          'anonymous';
        if (!best.has(name)) best.set(name, row.score);
      }
      const top = [...best.entries()].slice(0, 10);

      list.innerHTML =
        top.length === 0
          ? `<li class="px-4 py-3 text-sm text-fg-subtle">No scores yet — be the first.</li>`
          : top
              .map(
                ([name, score], i) => `
                  <li class="flex items-center justify-between px-4 py-2.5 text-sm">
                    <span class="flex items-center gap-3">
                      <span class="w-5 text-right text-fg-subtle">${i + 1}</span>
                      <span class="text-fg">${name.replace(/[<>&]/g, '')}</span>
                    </span>
                    <span class="font-medium text-accent-alt">${score.toLocaleString()}</span>
                  </li>`,
              )
              .join('');
    }

    async function submitScore(score: number) {
      const { data: sessionData } = await supabase.auth.getSession();
      const session = sessionData.session;
      if (!session) {
        status.textContent = 'Log in to post your scores.';
        return;
      }
      const { error } = await supabase.from('scores').insert({
        user_id: session.user.id,
        game: gameSlug,
        score,
      });
      if (!error) {
        status.textContent = `Score saved: ${score.toLocaleString()}`;
        loadLeaderboard();
      }
    }

    window.addEventListener('message', (event) => {
      if (event.origin !== gameOrigin) return;
      const msg = event.data;
      if (
        msg?.type === 'blocks:gameover' &&
        typeof msg.score === 'number' &&
        msg.score > 0
      ) {
        submitScore(Math.floor(msg.score));
      }
    });

    loadLeaderboard();
  }
</script>
